FROM golang:1.18.1 as builder

RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - && apt-get install --yes nodejs && npm install --global yarn

WORKDIR /app
COPY . .

ENV GO111MODULE=on
RUN make download-tools install generate build-bin-local

FROM scratch
WORKDIR /opt/traggo
COPY --from=builder /app/build/traggo-server /opt/traggo/traggo
EXPOSE 3030
ENTRYPOINT ["./traggo"]
